@model Notesphere.Entities.NotesModels.Note

@{
    ViewData["Title"] = "Create a new note";
}

<link rel="stylesheet" href="~/css/Notes.css" asp-append-version="true" />

<div class="ns-note-create">
    <h1 class="ns-note-create-title">Create a new note</h1>

    <form asp-action="Create" method="post">
       
        <div class="ns-title-row">
            <input asp-for="Title"
                   class="ns-input"
                   placeholder="Note title..." />
        </div>

        <div class="ns-content-row">
            <textarea asp-for="Content"
                      class="ns-textarea"
                      placeholder="Start typing your note here..."></textarea>
        </div>

        <div class="ns-favorite-row">
            <input asp-for="IsFavorite" type="checkbox" />
            <span>Mark as favorite</span>
        </div>

        <div class="ns-actions-row">
            <button type="submit" class="ns-btn-primary">Create Note</button>
            <a asp-action="Index" class="ns-btn-link">Back to list</a>
        </div>
    </form>
</div>
