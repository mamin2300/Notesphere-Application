@model Notesphere.Entities.NotesModels.Note
@{
    ViewData["Title"] = "Edit note";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/Notes.css" />
<link rel="stylesheet" href="~/css/notes-list.css" />

<main class="ns-note-page">
    <header class="ns-note-header">
        <div>
            <a asp-action="Index" class="ns-link-small">← Back to notes</a>
            <h1 class="ns-page-title">Edit note</h1>
            <p class="ns-page-subtitle">
                Update the title, quick text summary and page style for this note.
            </p>
        </div>
    </header>

    <section class="ns-note-card">
        <!-- hidden validation summary  -->
        <div asp-validation-summary="ModelOnly"
             class="text-danger d-none"
             id="validationSummary"></div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <!-- hidden fields required by the controller -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="StudentUserId" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="UpdatedAt" />

            <!-- TITLE -->
            <div class="ns-form-row">
                <label asp-for="Title" class="ns-label"></label>
                <input asp-for="Title" class="ns-input" />
            </div>

            <!-- TEXT SUMMARY (Content) -->
            <div class="ns-form-row">
                <label class="ns-label" for="Content">Quick text summary</label>
                <textarea asp-for="Content"
                          id="Content"
                          class="ns-input ns-input-multiline"
                          placeholder="Optional: short text version of this note..."></textarea>
            </div>

            <!-- FAVORITE -->
            <div class="ns-form-row ns-form-row-inline">
                <label class="ns-checkbox">
                    <input asp-for="IsFavorite" />
                    <span>Mark as favorite</span>
                </label>
            </div>

            <!-- PAGE STYLE (TemplateId) -->
            <div class="ns-form-row">
                <label asp-for="TemplateId" class="ns-label">Page style</label>
                <select asp-for="TemplateId" class="ns-input">
                    <option value="1">Lined</option>
                    <option value="2">Dotted</option>
                    <option value="3">Grid</option>
                </select>
            </div>

            <!-- META INFO -->
            <div class="ns-form-meta">
                <span>Created @Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span>
                <span>Last updated @Model.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span>
            </div>

            <!-- ACTION BUTTONS -->
            <div class="ns-form-actions">
                <button type="submit" class="ns-btn-primary">Save changes</button>
                <a asp-action="Index" class="ns-btn-link">Cancel</a>
                <a asp-action="Delete" asp-route-id="@Model.Id"
                   class="ns-btn-danger-outline ns-btn-danger-solid">
                    Delete note
                </a>
            </div>
        </form>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const summary = document.getElementById("validationSummary");
            if (!summary) return;

            const text = summary.innerText.trim();
            if (text.length > 0) {
                alert("Please fix the following problems:\n\n" + text);
            }
        });
    </script>
}
