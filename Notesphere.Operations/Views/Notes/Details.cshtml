@model Notesphere.Entities.NotesModels.Note
@{
    ViewData["Title"] = "Note details";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/notes-list.css" />

<main class="ns-note-page">
    <header class="ns-note-header">
        <div>
            <a asp-action="Index" class="ns-link-small">← Back to notes</a>
            <h1 class="ns-page-title">@Model.Title</h1>
            <p class="ns-page-subtitle">
                Created @Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                · Last updated @Model.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
            </p>
        </div>

        <div class="ns-note-header-actions">
            <a asp-action="Editor" asp-route-id="@Model.Id" class="ns-btn-primary">
                Open in editor
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="ns-btn-link">
                Edit
            </a>
        </div>
    </header>

    <section class="ns-note-card ns-note-details">
        <dl class="ns-details-grid">
            <div>
                <dt>Owner</dt>
                <dd>@Model.StudentUserId</dd>
            </div>

            <div>
                <dt>Favorite</dt>
                <dd>@(Model.IsFavorite ? "Yes" : "No")</dd>
            </div>

            <div>
                <dt>Page style</dt>
                <dd>
                    @{
                        var style = Model.TemplateId switch
                        {
                            1 => "Lined",
                            2 => "Dotted",
                            3 => "Grid",
                            _ => "Default"
                        };
                    }
                    @style
                </dd>
            </div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <div class="ns-note-content-preview">
                <h3>Text summary</h3>
                <p>@Model.Content</p>
            </div>
        }
        else
        {
            <p class="ns-muted-small">
                No text summary yet. You can add one from the editor or Edit page.
            </p>
        }
    </section>
</main>
