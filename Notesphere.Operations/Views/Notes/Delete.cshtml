@model Notesphere.Entities.NotesModels.Note
@{
    ViewData["Title"] = "Delete note";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/notes-list.css" />

<main class="ns-note-page">
    <header class="ns-note-header">
        <div>
            <a asp-action="Index" class="ns-link-small">← Back to notes</a>
            <h1 class="ns-page-title">Delete note</h1>
            <p class="ns-page-subtitle">
                This action can’t be undone. The note pages and text summary will be removed.
            </p>
        </div>
    </header>

    <section class="ns-note-card ns-note-delete">
        <div class="ns-delete-warning">
            <strong>Are you sure you want to delete “@Model.Title”?</strong>
        </div>

        <dl class="ns-details-grid">
            <div>
                <dt>Created</dt>
                <dd>@Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</dd>
            </div>
            <div>
                <dt>Last updated</dt>
                <dd>@Model.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</dd>
            </div>
            <div>
                <dt>Favorite</dt>
                <dd>@(Model.IsFavorite ? "Yes" : "No")</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="ns-form-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="ns-btn-danger-outline ns-btn-danger-solid">
                Delete forever
            </button>
            <a asp-action="Index" class="ns-btn-link">Cancel</a>
        </form>
    </section>
</main>
