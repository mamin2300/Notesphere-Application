@model IEnumerable<Notesphere.Entities.NotesModels.Note>

@{
    ViewData["Title"] = "Notes";
}

<link rel="stylesheet" href="~/css/notes-list.css" />

<div class="ns-notes-wrapper">
    <div class="ns-notes-header">
        <h1 class="ns-notes-title">Notes</h1>
        <a asp-action="Create" class="ns-btn-primary">Create New</a>
    </div>

    @if (!Model.Any())
    {
        <p class="ns-notes-empty">
            You don’t have any notes yet. Click “Create New” to start.
        </p>
    }
    else
    {
        <div class="ns-notes-grid">
            @foreach (var note in Model)
            {
                <div class="ns-note-card">
                    <div class="ns-note-card-header">
                        <h3 class="ns-note-card-title">@note.Title</h3>

                        @if (note.IsFavorite)
                        {
                            <span class="ns-note-badge">★ Favorite</span>
                        }
                </div>

                <p class="ns-note-snippet">
                    @(
                                    !string.IsNullOrWhiteSpace(note.Content)
                                    ? (note.Content.Length > 80
                                    ? note.Content.Substring(0, 80) + "..."
                                    : note.Content)
                                    : "No text yet – open in editor to start writing."
                                    )
                </p>

                <div class="ns-note-meta">
                    <span>
                        Template:
                        @(
                                            note.TemplateId == 1 ? "Lined" :
                                            note.TemplateId == 2 ? "Dotted" :
                                            note.TemplateId == 3 ? "Grid" : "Blank"
                                            )
                    </span>
                    <span>Created @note.CreatedAt.ToShortDateString()</span>
                </div>

                    <div class="ns-note-actions">
                        <a asp-action="Editor" asp-route-id="@note.Id" class="ns-note-btn-main">
                            Open in Editor
                        </a>
                        <a asp-action="Edit" asp-route-id="@note.Id" class="ns-note-btn-secondary">Edit</a>
                        <a asp-action="Details" asp-route-id="@note.Id" class="ns-note-btn-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@note.Id" class="ns-note-btn-danger">Delete</a>
                    </div>
                </div>
                }
        </div>
    }
</div>
