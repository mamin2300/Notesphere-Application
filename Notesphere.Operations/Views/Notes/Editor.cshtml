@model Notesphere.Entities.NotesModels.Note
@using Notesphere.Entities.NotesModels

@{
    Layout = "_Layout";
    ViewData["Title"] = "Notebook Editor";

    string templateClass = Model.TemplateId switch
    {
        1 => "page-template-lined",
        2 => "page-template-dotted",
        3 => "page-template-boxed",
        _ => "page-template-blank"
    };

    var pages = ViewBag.Pages as List<NotePage> ?? new List<NotePage>();
}

<link rel="stylesheet" href="~/css/goodnotes.css" />

<div class="gn-editor-wrapper">

    <!-- SIDEBAR -->
    <div class="gn-sidebar">
        <h3 class="gn-sidebar-title">Pages</h3>

        <div id="pageList">
            @foreach (var p in pages)
            {
                <div class="gn-thumb"
                     data-page="@p.PageNumber"
                     data-image="@p.ImageData"
                     onclick="loadPage(@p.PageNumber)">
                    <span>Page @p.PageNumber</span>
                </div>
            }
        </div>

        <button class="gn-add-page" onclick="addNewPage()">+ Add Page</button>
        <button class="gn-delete-page" onclick="deleteCurrentPage()">Delete Page</button>
    </div>

    <!-- MAIN AREA -->
    <div class="gn-main">

        <!-- TOOLBAR -->
        <div class="gn-toolbar">
            <button type="button" id="tool_pen" class="gn-tool-btn" onclick="selectTool('pen')">✎</button>
            <button type="button" id="tool_highlighter" class="gn-tool-btn" onclick="selectTool('highlighter')">🖍</button>
            <button type="button" id="tool_eraser" class="gn-tool-btn" onclick="selectTool('eraser')">🩹</button>
            <button type="button" id="tool_text" class="gn-tool-btn" onclick="selectTool('text')">T</button>

            <span class="divider"></span>

            <button type="button" onclick="undoCanvas()" class="gn-tool-btn">↶</button>
            <button type="button" onclick="redoCanvas()" class="gn-tool-btn">↷</button>

            <span class="divider"></span>

            <label class="gn-thickness-label">Size</label>
            <input type="range" id="brushSize" min="4" max="45" value="12" />

            <span class="divider"></span>

            <div class="gn-color-picker">
                <div class="color" style="background:#0A0908;" onclick="setColor('#0A0908')"></div>
                <div class="color" style="background:#49111C;" onclick="setColor('#49111C')"></div>
                <div class="color" style="background:#A9927D;" onclick="setColor('#A9927D')"></div>
                <div class="color" style="background:#5E503F;" onclick="setColor('#5E503F')"></div>
                <div class="color" style="background:#F2F4F3;" onclick="setColor('#F2F4F3')"></div>
            </div>
        </div>

        <!-- PAGE CONTAINER -->
        <div class="gn-main-inner">
            <div id="gn-page" class="gn-page @templateClass">

                <!-- IMPORTANT ORDER: Canvas below, text layer above -->
                <canvas id="noteCanvas"></canvas>

                <!-- FIXED TEXT LAYER -->
                <div id="textLayer" class="gn-text-layer"></div>

            </div>
        </div>

        <button class="gn-save-btn" type="button" onclick="saveCurrentPage()">Save Page</button>
    </div>

</div>

<!-- Metadata for JS -->
<div id="noteMeta"
     data-note-id="@Model.Id"
     data-pages-count="@pages.Count">
</div>

<script src="~/js/goodnotes.js"></script>
