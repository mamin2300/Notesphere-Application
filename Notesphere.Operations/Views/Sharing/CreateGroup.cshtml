@model Notesphere.Operations.Models.Sharing.CreateGroupSpaceViewModel

@{
    ViewData["Title"] = "Create Group";
}

<div class="ns-sharing-page">
    <div class="ns-sharing-header">
        <div>
            <h2 class="ns-sharing-title">Create Group</h2>
            <p class="ns-sharing-subtitle">
                Set up a collaboration space for sharing notes with classmates.
            </p>
        </div>
    </div>

    <div class="ns-form-card">
        <form asp-action="CreateGroup" method="post">
            <div class="ns-form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="ns-form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description"></textarea>
            </div>

            <div class="ns-form-actions">
                <button type="submit" class="ns-btn-primary">Create</button>
                <a asp-action="MyGroups" class="ns-btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
