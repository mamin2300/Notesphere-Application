@model List<Notesphere.Operations.Models.Sharing.SharedNoteListItemViewModel>

@{
    ViewData["Title"] = "Shared With Me";
}

<div class="ns-sharing-page">
    <div class="ns-sharing-header">
        <div>
            <h2 class="ns-sharing-title">Shared With Me</h2>
            <p class="ns-sharing-subtitle">
                Notes that other students or groups have shared with you.
            </p>
        </div>
    </div>

    <div class="ns-sharing-card">
        <table class="ns-sharing-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>From</th>
                    <th>Group</th>
                    <th>Can Edit?</th>
                    <th>Shared On</th>
                    <th>Target</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <span class="ns-help-text">
                                Nothing has been shared with you yet.
                            </span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NoteId</td>
                            <td>@item.SharedBy</td>
                            <td>@item.SharedTo</td>
                            <td>@(item.CanEdit ? "Yes" : "No")</td>
                            <td>@item.SharedNoteId</td>
                            <td>@item.TargetType</td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>

