@model List<Notesphere.Operations.Models.Sharing.GroupSpaceListItemViewModel>

@{
    ViewData["Title"] = "My Groups";
}

<div class="ns-sharing-page">
    <div class="ns-sharing-header">
        <div>
            <h2 class="ns-sharing-title">My Groups</h2>
            <p class="ns-sharing-subtitle">
                Manage your collaboration spaces for shared notes and discussions.
            </p>
        </div>

        <div class="ns-sharing-actions">
            <a asp-action="CreateGroup" class="ns-btn-primary">Create New Group</a>
        </div>
    </div>

    <div class="ns-sharing-card">
        <table class="ns-sharing-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Members</th>
                    <th>Your Role</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4">
                            <span class="ns-help-text">
                                You don't have any groups yet. Create one to start collaborating.
                            </span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var g in Model)
                    {
                        <tr>
                            <td>@g.Name</td>
                            <td>@g.Description</td>
                            <td>@g.MemberCount</td>
                            <td><span class="ns-pill-role">@g.Role</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
