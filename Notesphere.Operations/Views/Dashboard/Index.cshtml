@model Notesphere.Operations.Models.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

     <!-- ============================= 
          NOTION SIDEBAR (HOVER / LOCK)
          ============================= -->
<div id="notionSidebar" class="ns-sidebar notion-hidden">

    <div class="ns-sidebar-header">
        <h5 class="ns-logo">Notesphere</h5>

        <button id="hamburgerBtn" class="btn ns-menu-btn">☰</button>
    </div>

    <nav class="ns-nav-section">
        <p class="ns-nav-title">Overview</p>
        <a href="@Url.Action("Index", "Notes")" class="ns-nav-link">Notes</a>
        <a href="@Url.Action("Index", "Planner")" class="ns-nav-link">Planner</a>
        <a href="@Url.Action("Index", "Productivity")" class="ns-nav-link">Productivity</a>
    </nav>

    <nav class="ns-nav-section mt-3">
        <p class="ns-nav-title">Workspaces</p>
        <a href="@Url.Action("MyGroups", "Sharing")" class="ns-nav-link">Sharing & Collaboration</a>
        <a href="@Url.Action("SharedWithMe", "Sharing")" class="ns-nav-link">Shared With Me</a>
        @foreach (var ws in Model.Workspaces)
        {
            var active = ws.Id == Model.SelectedWorkspaceId ? "ns-nav-link-active" : "";
            <a href="@Url.Action("Index", new { workspaceId = ws.Id })"
               class="ns-nav-link @active">
                @ws.Name
            </a>
        }
    </nav>

    <button class="btn ns-btn-primary w-100 mt-auto"
            onclick="location.href='@Url.Action("Create", "Notes")'">
        Create note
    </button>

</div>

     <!-- =============================
                 MAIN WRAPPER 
          ============================= -->
<div id="appWrapper" class="ns-app-wrapper">

    <main class="ns-main">

        <!-- TOPBAR -->
        <header class="ns-topbar">

            <!-- Hamburger button -->

            <div class="ns-header-block">
                <h1 class="ns-page-title">Today</h1>
                <p class="ns-page-subtitle">
                    @Model.Today.ToString("dddd, MMM dd") ·
                    @Model.TotalNotes note(s) ·
                    @Model.FavoriteNotesCount favorite(s)
                </p>
            </div>

            <div class="ns-topbar-right">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <span class="ns-chip">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ns-chip ns-chip-active">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="ns-chip ns-chip-active">Login</a>
                }
            </div>

        </header>

        <!-- TABS -->
        <div class="ns-tabs">
            <button class="ns-tab ns-tab-active">Overview</button>
            <button class="ns-tab">Notes</button>
            <button class="ns-tab">Planner</button>
            <button class="ns-tab">Files</button>
        </div>

        @* ---- QUICK NOTES ---- *@

        <section class="ns-section-header">
            <div>
                <h2 class="ns-section-title">Quick notes</h2>
                <p class="ns-section-subtitle">Your latest notes at a glance.</p>
            </div>
            <a class="ns-link-small" href="@Url.Action("Index", "Notes")">View all notes →</a>
        </section>

        <section class="ns-card-row">
            @if (!Model.RecentNotes.Any())
            {
                <div class="ns-empty">
                    <p>No notes yet. Create your first note to get started.</p>
                    <a class="ns-btn-primary" href="@Url.Action("Create", "Notes")">Create note</a>
                </div>
            }
            else
            {
                @foreach (var note in Model.RecentNotes)
                {
                    <article class="ns-card">
                        <div class="ns-card-top">
                            <span class="ns-card-badge">@note.UpdatedAt.ToLocalTime().ToString("MMM dd")</span>
                            @if (note.IsFavorite)
                            {
                                <span class="ns-card-star">★</span>
                            }
                        </div>

                        <p class="ns-card-text">
                            @{
                                var preview = note.Content ?? "";
                            }
                            @(preview.Length > 110 ? preview.Substring(0, 107) + "..." : preview)
                        </p>

                        <a class="ns-card-link"
                           href="@Url.Action("Editor", "Notes", new { id = note.Id })">
                            Open note →
                        </a>
                    </article>
                }
            }
        </section>

        <div class="ns-second-row">

            <section class="ns-box">
                <div class="ns-box-header">
                    <h3>Upcoming reminders</h3>
                    <a class="ns-link-small" href="#">View all</a>
                </div>

                @if (!Model.Reminders.Any())
                {
                    <p class="ns-muted-small">No reminders for the next 7 days.</p>
                }
                else
                {
                    <ul class="ns-list">
                        @foreach (var r in Model.Reminders)
                        {
                            <li>
                                <span class="ns-list-title">@r.Title</span>
                                <span class="ns-list-meta">@r.CreatedAt.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="ns-box ">
                <div class="ns-box-header">
                    <h3>Favorite notes</h3>
                    <span class="ns-muted-small">@Model.FavoriteNotesCount total</span>
                </div>

                @if (!Model.FavoriteNotes.Any())
                {
                    <p class="ns-muted-small">Mark a note as favorite to see it here.</p>
                }
                else
                {
                    <ul class="ns-list">
                        @foreach (var n in Model.FavoriteNotes)
                        {
                            <li>
                                <span class="ns-list-title">@n.Title</span>
                                <span class="ns-list-meta">Updated @n.UpdatedAt.ToLocalTime().ToString("MMM dd")</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="ns-box ns-todo">

                <div class="ns-box-header">
                    <h3>To-Do List</h3>
                </div>

                <div class="todo-input-row">
                 <input id="todoInput" type="text" placeholder="Add a new task..." class="todo-input"/>
                    <button id="addTodoBtn" class="todo-add-btn">+</button>
                 </div>

                 <ul id="todoList" class="todo-list">
                 </ul>
            </section>
        </div>
    </main>
</div>

<script src="~/js/Dashboard-Sidebar.js"></script>
<script src="~/js/todo.js"></script>

