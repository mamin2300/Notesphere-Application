@model Notesphere.Operations.Models.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="ns-app-wrapper">
    <!-- SIDEBAR -->
    <aside class="ns-sidebar">
        <div class="ns-logo">Notesphere</div>

        <nav class="ns-nav-section">
            <p class="ns-nav-title">Overview</p>
            <a href="#" class="ns-nav-link ns-nav-link-active">Dashboard</a>
            <a href="@Url.Action("Index", "Notes")" class="ns-nav-link">Notes</a>
            <a href="#" class="ns-nav-link">Planner</a>
            <a href="#" class="ns-nav-link">Completed</a>
        </nav>

        <nav class="ns-nav-section">
            <p class="ns-nav-title">Workspaces</p>
            @foreach (var ws in Model.Workspaces)
            {
                var active = ws.Id == Model.SelectedWorkspaceId ? "ns-nav-link-active" : "";
                <a href="@Url.Action("Index", new { workspaceId = ws.Id })"
                   class="ns-nav-link @active">
                    @ws.Name
                </a>
            }
        </nav>

        <button class="ns-btn-primary" onclick="location.href='@Url.Action("Create", "Notes")'">
            Create note
        </button>

    </aside>

    <!-- MAIN -->
    <main class="ns-main">
        <header class="ns-topbar">
            <div>
                <h1 class="ns-page-title">Today</h1>
                <p class="ns-page-subtitle">
                    @Model.Today.ToString("dddd, MMM dd") ·
                    @Model.TotalNotes note(s) ·
                    @Model.FavoriteNotesCount favorite(s)
                </p>
            </div>
            <div class="ns-topbar-right">
                <span class="ns-chip ns-chip-active">All</span>
            </div>
        </header>

        <!-- Tabs -->
        <div class="ns-tabs">
            <button class="ns-tab ns-tab-active">Overview</button>
            <button class="ns-tab">Notes</button>
            <button class="ns-tab">Planner</button>
            <button class="ns-tab">Files</button>
        </div>

        <!-- Product planning / main cards -->
        <section class="ns-section-header">
            <div>
                <h2 class="ns-section-title">Quick notes</h2>
                <p class="ns-section-subtitle">Your latest notes at a glance.</p>
            </div>
            <a class="ns-link-small" href="@Url.Action("Index", "Notes")">View all notes →</a>
        </section>

        <section class="ns-card-row">
            @if (!Model.RecentNotes.Any())
            {
                <div class="ns-empty">
                    <p>No notes yet. Create your first note to get started.</p>
                    <a class="ns-btn-primary" href="@Url.Action("Create", "Notes")">
                        Create note
                    </a>
                </div>
            }
            else
            {
                @foreach (var note in Model.RecentNotes)
                {
                    <article class="ns-card">
                        <div class="ns-card-top">
                            <span class="ns-card-badge">
                                @note.UpdatedAt.ToLocalTime().ToString("MMM dd")
                            </span>
                            @if (note.IsFavorite)
                            {
                                <span class="ns-card-star">★</span>
                            }
                    </div>
                    <h3 class="ns-card-title">@note.Title</h3>
                    <p class="ns-card-text">
                        @(
                                            (note.Content ?? "").Length > 110
                                            ? note.Content.Substring(0, 107) + "..."
                                            : note.Content
                                            )
                    </p>
                    <a class="ns-card-link"
                       href="@Url.Action("Details", "Notes", new { id = note.Id })">
                        Open note →
                    </a>
                </article>
                        }
            }
        </section>

        <!-- Second row: reminders + favorites -->
        <div class="ns-second-row">
            <section class="ns-box">
                <div class="ns-box-header">
                    <h3>Upcoming reminders</h3>
                    <a class="ns-link-small" href="#">View all</a>
                </div>
                @if (!Model.Reminders.Any())
                {
                    <p class="ns-muted-small">No reminders for the next 7 days.</p>
                }
                else
                {
                    <ul class="ns-list">
                        @foreach (var r in Model.Reminders)
                        {
                            <li>
                                <span class="ns-list-title">@r.Title</span>
                                <span class="ns-list-meta">
                                    @r.CreatedAt.ToLocalTime().ToString("MMM dd, h:mm tt")
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="ns-box">
                <div class="ns-box-header">
                    <h3>Favorite notes</h3>
                    <span class="ns-muted-small">@Model.FavoriteNotesCount total</span>
                </div>
                @if (!Model.FavoriteNotes.Any())
                {
                    <p class="ns-muted-small">Mark a note as favorite to see it here.</p>
                }
                else
                {
                    <ul class="ns-list">
                        @foreach (var n in Model.FavoriteNotes)
                        {
                            <li>
                                <span class="ns-list-title">@n.Title</span>
                                <span class="ns-list-meta">
                                    Updated @n.UpdatedAt.ToLocalTime().ToString("MMM dd")
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="ns-box">
                <div class="ns-box-header">
                    <h3>Quick actions</h3>
                </div>
                <div class="ns-actions-grid">
                    @foreach (var qa in Model.QuickActions)
                    {
                        <button class="ns-action-btn"
                                onclick="location.href='@qa.TargetRoute'">
                            @qa.Label
                        </button>
                    }
                </div>
            </section>
        </div>
    </main>
</div>
