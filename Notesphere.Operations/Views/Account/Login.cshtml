@model Notesphere.Operations.Models.Notes.LoginViewModel

@{
    ViewData["Title"] = "Login";
}
<link rel="stylesheet" href="~/css/Notes.css" />

<div class="ns-note-create">
    <h1 class="ns-note-create-title">Log in</h1>

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />

        <div class="ns-owner-row">
            <label class="ns-label">Email</label>
            <input asp-for="Email" class="ns-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="ns-owner-row">
            <label class="ns-label">Password</label>
            <input asp-for="Password" class="ns-input" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="ns-actions-row">
            <button type="submit" class="ns-btn-primary">Login</button>
            <a asp-action="Register" class="ns-btn-link">Create new account</a>
        </div>

        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
