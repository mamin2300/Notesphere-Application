@model Notesphere.Operations.Models.Notes.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}
<link rel="stylesheet" href="~/css/Notes.css" />

<div class="ns-note-create">
    <h1 class="ns-note-create-title">Create account</h1>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div class="ns-owner-row">
            <label class="ns-label">Name</label>
            <input asp-for="Name" class="ns-input" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="ns-owner-row">
            <label class="ns-label">Email</label>
            <input asp-for="Email" class="ns-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="ns-owner-row">
            <label class="ns-label">Password</label>
            <input asp-for="Password" class="ns-input" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="ns-owner-row">
            <label class="ns-label">Confirm password</label>
            <input asp-for="ConfirmPassword" class="ns-input" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="ns-actions-row">
            <button type="submit" class="ns-btn-primary">Register</button>
            <a asp-action="Login" class="ns-btn-link">Already have an account? Log in</a>
        </div>

        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
